@model INSPECTORATEJobs.Models.Attachment
   @{ ViewBag.Title = "Attachments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="page-content">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet light portlet-fit bordered">
                @Html.Action("Notification")
                <div class="portlet-title">
                    <div class="caption">
                        <i class="icon-settings font-red"></i>
                        @*<span class="caption-subject font-red sbold uppercase">Step 1 (12.5%): Attachments</span>*@
                        <span class="caption-subject font-red sbold uppercase"> Attachments</span>
                    </div>
                </div>
                <div class="portlet-body">
                    <div class="box-body">
                        <form action="@Url.Action("SubmitAttachment", "JobApplication")" method="post" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-md-12">
                                    <p>Upload your CV and other supporting documents (Less than 5 MB)</p>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Attachment</label>
                                        <input type="file" name="AttachmentFile" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-linkedin"><i class="fa fa-upload"></i>&nbsp;Upload</button>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <br />
                        <br />
                        <div class="row">
                            <div class="col-md-12">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>#No</th>
                                            <th>Document No</th>
                                            <th>Description</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var attachment in @Model.ApplicantAttachments)
                                        {
                                            <tr>
                                                <td>@attachment.Counter</td>
                                                <td>@attachment.DocumentNo</td>
                                                <td>@attachment.Description</td>
                                                <td>@Convert.ToDateTime(attachment.CreatedAt).ToShortDateString()</td>
                                                <td class="text-center"><a href="@Url.Action("removeattachment","jobapplication", new { systemId = attachment.SystemId })" class="label label-danger"><i class="fa fa-trash"></i></a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <a href="@Url.Action("complete","jobapplication")" class="btn btn-primary pull-right"><i class="fa fa-paper-plane"></i>&nbsp;Next</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
