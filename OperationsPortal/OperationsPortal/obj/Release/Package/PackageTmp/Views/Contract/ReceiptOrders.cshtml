@model IEnumerable<OperationsPortal.Models.ContractOrders>
@{
    ViewBag.Title = "Receipt Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-content">
    <!-- BEGIN PAGE HEADER-->
    <!-- BEGIN PAGE BAR -->
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="@Url.Action("index", "dashboard")">Home</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="#">Dashboard</a>
                <i class="fa fa-circle"></i>
            </li>
        </ul>
    </div>
    <!-- END PAGE BAR -->


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            <button class="close" data-close="alert"></button>
            <span> @ViewBag.Error </span>
        </div>
    }
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">
            <button class="close" data-close="alert"></button>
            <span> @ViewBag.Success </span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <button class="close" data-close="alert"></button>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <button class="close" data-close="alert"></button>
            <span>@TempData["Success"]</span>
        </div>
    }
    <!-- BEGIN PAGE TITLE
    <h1 class="page-title">
        NMK Tenders Portal
    </h1>
    <!-- END PAGE TITLE-->
    <!-- END PAGE HEADER-->
    <div class="row">
        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet light portlet-fit bordered">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="icon-settings font-red"></i>
                        <span class="caption-subject font-red sbold uppercase">My WareHouse Receipts </span>
                    </div>
                </div>
                <div class="portlet-body">
                    @*<form action="@Url.Action("BeneficiaryNomination", "Statements")" method="get">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">  </label>
                                        <button type="submit" class="btn btn-primary  pull-right">Download form</button>

                                    </div>
                                </div>

                            </div>
                        </form>*@
                    <div class="table-toolbar">
                    </div>
                    <table class="table table-striped table-hover table-bordered" id="orders">
                        <thead>
                            <tr>
                                <th> No  </th>
                                <th> Date  </th>
                                <th> Description </th>
                                <th> Contract No. </th>
                                <th> Status </th>
                                <th> Action </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Equals(null))
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.No</td>
                                        <td>@item.Date</td>
                                        <td>@item.Description</td>
                                        <td>@item.contractNo</td>
                                        <td>@item.Status</td>
                                        <td>
                                            <a href="@Url.Action("WarehouseReceipt", "Report", new { receiptNo = item.No, contractNo=item.contractNo })">View Report</a>

                                        </td>

                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $('#orders').DataTable({
            "pageLength": 10, // Ensure this is applied
            "lengthMenu": [[15, 25, 50, -1], [15, 25, 50, "All"]], // Dropdown options
            "ordering": true,
            "searching": true,
            "stateSave": true, // Remember user preferences
            retrieve: true
        });
    });

</script>